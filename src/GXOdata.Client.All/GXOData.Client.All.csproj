<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net7.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Simple.OData.Client</RootNamespace>
    <OutputPath>$(SolutionDir)/build/$(Configuration)/$(AssemblyName)/$(TargetFramework)/</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DocumentationFile>..\GXOData.Client.All\GXOData.Client.All.xml</DocumentationFile>
    <DefineConstants>TRACE</DefineConstants>
    <NoWarn>1701;1702;1705;1591;1712;1573</NoWarn>
    <!-- Absolute path to the nuspec living at the repo root. Passing this relative
         via -p:NuspecFile=..\..\GXOData.Client.nuspec on the command line did not
         resolve correctly inside `dotnet pack`. -->
    <NuspecFile>$(MSBuildThisFileDirectory)..\..\GXOData.Client.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildThisFileDirectory)..\..\</NuspecBasePath>
    <!-- The nuspec doesn't enumerate source/symbol files, so let pack skip the snupkg. -->
    <IncludeSymbols>false</IncludeSymbols>
    <!-- The release nupkg is produced by the explicit `dotnet pack` step in the workflow.
         Suppress the auto-pack on build that upstream's Directory.Build.props turns on,
         otherwise we ship an extra (default-versioned) GXOData.Client.All.1.0.0.nupkg. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.OData" Version="[5.*, 6.0.0)" />
    <PackageReference Include="Microsoft.OData.Core" Version="[7.4.4, 8.0)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Simple.OData.Client.Core\**\*.cs" Exclude="**\AssemblyInfo.cs;..\Simple.OData.Client.Core\obj\**" Label="Core" />
    <Compile Include="..\Simple.OData.Client.V3.Adapter\**\*.cs" Exclude="**\AssemblyInfo.cs;..\Simple.OData.Client.V3.Adapter\obj\**" Label="V3Adapter" />
    <Compile Include="..\Simple.OData.Client.V4.Adapter\**\*.cs" Exclude="**\AssemblyInfo.cs;..\Simple.OData.Client.V4.Adapter\obj\**" Label="V4Adapter" />
  </ItemGroup>

	<ItemGroup>
	  <Compile Remove="Properties\CommonAssemblyVersion.cs" />
	</ItemGroup>

</Project>
